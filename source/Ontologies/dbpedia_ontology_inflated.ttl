<http://dbpedia.org/ontology/dose> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Dose"@en,
        "Dose"@fr,
        "剂量"@zh ;
    rdfs:comment "Dose means quantity (in units of energy/mass) in the fields of nutrition, medicine, and toxicology. Dosage is the rate of application of a dose, although in common and imprecise usage, the words are sometimes used synonymously."@en,
        "Dose signifie quantité (en unités d'énergie/masse) dans les domaines de la nutrition, la médecine et la toxicologie. Le dosage est le taux d'application d'une dose, bien que dans l'utilisation habituelle et imprécise qui en est faite, les mots sont quelques fois synonymes."@fr ;
    rdfs:isDefinedBy <http://dbpedia.org/ontology/> ;
    rdfs:range xsd:integer ;
    owl:equivalentProperty <http://dbpedia.org/ontology/dose> ;
    owl:sameAs <http://dbpedia.org/ontology/dose> ;
    ns0:describedby <http://dbpedia.org/ontology/data/definitions.ttl> ;
