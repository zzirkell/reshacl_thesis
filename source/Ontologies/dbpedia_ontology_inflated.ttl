    ns0:describedby <http://dbpedia.org/ontology/data/definitions.ttl> ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyProperty:callsignMeaning> .

<http://dbpedia.org/ontology/campus> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "Campus"@de,
        "πανεπιστημιούπολη"@el,
        "campus"@en,
        "campus"@fr,
        "جامع کا علقه"@ur ;
    rdfs:comment "Πανεπιστημιούπολη εννοείται κάθε πολεοδομικό συγκρότημα που προσφέρει οικιστικές, διδακτικές και ερευνητικές διευκολύνσεις στους φοιτητές ενός πανεπιστημίου."@el,
        "Campus means any urban complex that offers residential, teaching and research facilities to the students of a university."@en,
        "Tout complexe urbain qui offre des installations résidentielles, d'enseignement et de recherche aux étudiants d'une université."@fr,
        "جامع کا علقه کا مطلب ہے کوئی بھی شہری جامع کا علقه جو جامع کے طلباء کو رہائشی، تدریسی اور تحقیقی سہولیات فراہم کرتا ہے۔"@ur ;
