    rdfs:domain <http://dbpedia.org/ontology/Person> ;
    rdfs:isDefinedBy <http://dbpedia.org/ontology/> ;
    rdfs:range xsd:nonNegativeInteger ;
    owl:sameAs <http://dbpedia.org/ontology/individualisedPnd> ;
    ns0:describedby <http://dbpedia.org/ontology/data/definitions.ttl> ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyProperty:individualisedPnd> .

