    rdfs:subClassOf <http://dbpedia.org/ontology/تِجارتی_اِدارہ> ;
    owl:sameAs <http://dbpedia.org/ontology/عوامی_راہداری_کا_نظام> ;
    ns0:describedby <http://dbpedia.org/ontology/data/definitions.ttl> ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:عوامی_راہداری_کا_نظام> .

