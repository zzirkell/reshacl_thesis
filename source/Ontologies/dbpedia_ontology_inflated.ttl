<http://dbpedia.org/ontology/individualisedGnd> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Gemeinsame Normdatei"@de,
        "individualised GND number"@en ;
    rdfs:comment "GND (Gemeinsame Normdatei) is an international authority file for the organisation of personal names, subject headings and corporate bodies from catalogues. It is used mainly for documentation in libraries and archives. The GND is managed by the German National Library in cooperation with various library networks. The GND falls under the Creative Commons Zero(CC0) license."@en ;
    rdfs:isDefinedBy <http://dbpedia.org/ontology/> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <http://dbpedia.org/ontology/code> ;
    owl:equivalentProperty <http://www.wikidata.org/entity/P227>,
        <https://d-nb.info/standards/elementset/gnd#gndIdentifier> ;
    owl:sameAs <http://dbpedia.org/ontology/individualisedGnd> ;
    ns0:describedby <http://dbpedia.org/ontology/data/definitions.ttl> ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyProperty:individualisedGnd> .

<http://dbpedia.org/ontology/individualisedPnd> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "Personennamendatei"@de,
        "individualised PND number"@en ;
