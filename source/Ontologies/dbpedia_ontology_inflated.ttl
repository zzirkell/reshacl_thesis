    rdfs:range xsd:string ;
    owl:sameAs <http://dbpedia.org/ontology/buildingEndDate> ;
    ns0:describedby <http://dbpedia.org/ontology/data/definitions.ttl> ;
    prov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyProperty:buildingEndDate> .

